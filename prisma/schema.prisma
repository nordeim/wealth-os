// WealthOS — Prisma schema (SQLite)
// Session-199: the finance domain, cloned from the reference app
// (https://wealth-os-d93bd04e.base44.app/): login users, income sources,
// transactions (income + expense, needs/wants/savings budgeting), bank
// accounts, investments, savings goals, category budgets and a settings
// singleton (currency, date format, notifications, theme).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#f59e0b")
  photoUrl     String?
  role         String   @default("user") // user | admin
  // The email-verification funnel (kept from the hardened auth): a NULL
  // verificationExpiresAt means "no verification pending" — seeded demo
  // users pass straight through login. The code is stored HASHED.
  verificationCodeHash String?
  verificationAttempts Int      @default(0)
  verificationExpiresAt DateTime?
  // The revocation dimension: every session token embeds the row's
  // tokenVersion; a password reset increments it and every previously
  // minted cookie dies at the getSessionUser comparison.
  tokenVersion Int @default(0)
  // The password-reset funnel: the resetToken column stores the hashed
  // form — hashResetToken(token), the SHA-256 hex of the raw token,
  // consumed ATOMICALLY and SINGLE-USE (60-minute TTL).
  resetToken          String?
  resetTokenExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  incomeSources IncomeSource[]
  transactions  Transaction[]
  bankAccounts  BankAccount[]
  investments   Investment[]
  goals         Goal[]
}

model IncomeSource {
  id              String    @id @default(cuid())
  name            String
  // salary | freelance | business | investment | rental | other
  type            String    @default("salary")
  amount          Float     @default(0)
  // monthly | weekly | biweekly | quarterly | annually
  frequency       String    @default("monthly")
  active          Boolean   @default(true)
  nextPaymentDate DateTime?
  notes           String?
  ownerId         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([type])
}

model Transaction {
  id          String   @id @default(cuid())
  description String
  amount      Float
  // income | expense
  type        String   @default("expense")
  // free-form category label ("Groceries", "Rent/Mortgage", …)
  category    String   @default("Other")
  // needs | wants | savings — the reference's 50/30/20-style budget split
  budgetCategory String @default("needs")
  date        DateTime
  notes       String?
  recurring   Boolean  @default(false)
  // next occurrence for recurring rows (feeds Upcoming & Alerts)
  nextDate    DateTime?
  accountId   String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  owner   User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([date])
  @@index([type])
  @@index([category])
  @@index([budgetCategory])
}

model BankAccount {
  id           String    @id @default(cuid())
  name         String
  // checking | savings | credit | investment | cash
  type         String    @default("checking")
  institution  String?
  balance      Float     @default(0)
  currency     String    @default("USD")
  lastSyncedAt DateTime  @default(now())
  color        String?
  ownerId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([ownerId])
  @@index([type])
}

model Investment {
  id           String    @id @default(cuid())
  symbol       String
  name         String
  // stock | etf | bond | crypto | realestate | other
  type         String    @default("stock")
  shares       Float     @default(1)
  avgCost      Float     @default(0)
  currentValue Float     @default(0)
  purchaseDate DateTime?
  notes        String?
  ownerId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([type])
}

model Goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?
  // emergency | vacation | house | car | retirement | education | other
  category      String    @default("other")
  // active | completed | paused
  status        String    @default("active")
  icon          String?
  ownerId       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([status])
}

model Budget {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  // monthly (the reference's single period today; enum kept for growth)
  period    String   @default("monthly")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, period])
}

model Setting {
  id               String   @id @default("singleton")
  defaultCurrency  String   @default("USD")
  dateFormat       String   @default("MM/dd/yyyy")
  pushNotifications Boolean @default(false)
  emailAlerts      Boolean  @default(false)
  budgetWarnings   Boolean  @default(true)
  monthlyReports   Boolean  @default(false)
  theme            String   @default("light") // light | dark | system
  updatedAt        DateTime @updatedAt
}
