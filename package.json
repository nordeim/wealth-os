{
  "name": "wealth-os",
  "version": "1.0.0",
  "description": "WealthOS — self-hostable premium personal-finance workspace (Next.js 16 + React 19 + Prisma/SQLite)",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && rm -f .next/standalone/.env",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint . --max-warnings 0",
    "db:push": "bun scripts/prisma-env.ts db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:seed": "bun prisma/seed.ts",
    "db:census": "bun scripts/census.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "gate": "bun run lint && bun run typecheck && bun run test && bun run build && ./scripts/smoke-test.sh && CI=1 bun run test:e2e",
    "smoke": "./scripts/smoke-test.sh",
    "sweep": "bun scripts/sweep.ts",
    "probe:ref": "bun scripts/drift-probe.ts",
    "gate:full": "bun run lint && bun run typecheck && bun run test && bun run build && ./scripts/smoke-test.sh && CI=1 bun run test:e2e && bun run sweep -- --fail-on-drift && bun run sweep -- --width 390 --height 844 --fail-on-drift && bun run sweep -- --width 768 --height 1024 --fail-on-drift && bun run sweep -- --width 1024 --height 768 --fail-on-drift && bun run sweep:fullpage -- --fail-on-drift && bun run census:interior -- --fail-on-drift --parallel 4",
    "sweep:fullpage": "bun scripts/fullpage-sweep.ts",
    "census:interior": "bun scripts/interior-census.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas-pro": "^2.5.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.525.0",
    "next": "^16.4.2",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true
  }
}
